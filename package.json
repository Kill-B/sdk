{
  "name": "@killb/sdk",
  "version": "2.5.2",
  "description": "KillB sdk",
  "main": "lib/cjs/index.js",
  "types": "./lib/cjs/types/index.d.ts",
  "directories": {
    "lib": "src"
  },
  "scripts": {
    "clean": "rm -rf lib",
    "build": "npm run clean && npm run build:cjs",
    "build:cjs": "tsc -p ./tsconfig.cjs.json",
    "prepack": "npm run build",
    "test": "jest --logHeapUsage --runInBand",
    "test:ci": "npm test -- --coverage --silent --noStackTrace",
    "test:dev": "npm test --watch",
    "semantic-release": "semantic-release",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kill-B/sdk.git"
  },
  "keywords": [
    "killb"
  ],
  "author": "Kill-B",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Kill-B/sdk/issues"
  },
  "homepage": "https://github.com/Kill-B/sdk#readme",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@faker-js/faker": "10.5.0",
    "@killb/code-style": "1.0.1",
    "@types/jest": "30.0.0",
    "dotenv": "17.4.2",
    "eslint": "10.14.0",
    "jest": "30.4.2",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "semantic-release": "25.0.8",
    "ts-jest": "29.4.12",
    "ts-node-dev": "2.0.0",
    "typescript": "5.9.3"
  },
  "exports": {
    ".": {
      "require": {
        "types": "./lib/cjs/types/index.d.ts",
        "default": "./lib/cjs/index.js"
      }
    }
  },
  "files": [
    "lib/**/*"
  ],
  "release": {
    "branches": [
      "main"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "axios": "1.20.0"
  },
  "overrides": {
    "axios": "1.20.0",
    "lodash-es": "4.18.0",
    "anymatch": {
      "picomatch": "2.3.2"
    },
    "micromatch": {
      "picomatch": "2.3.2"
    },
    "readdirp": {
      "picomatch": "2.3.2"
    }
  },
  "prettier": "@killb/code-style/prettier"
}
